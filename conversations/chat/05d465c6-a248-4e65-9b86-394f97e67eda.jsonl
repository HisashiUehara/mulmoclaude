{"source":"assistant","type":"text","message":"では、フル機能のアプリを構築します。動画アップロード → 3D姿勢推定 → グリップ力ベクトル解析 → 自習コーチングまでを1つのアプリにまとめます。"}
{"source":"tool","type":"tool_call","toolUseId":"toolu_01SoLzdCpGTPyJxMRYhfADXu","toolName":"mcp__mulmoclaude__presentHtml","args":{"title":"Golf 3D Swing Force Analyzer","html":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Golf 3D Swing Force Analyzer</title>\n<style>\n  :root{\n    --bg:#0a0e14; --panel:#131a24; --panel2:#1b2430; --line:#26313f;\n    --txt:#e7edf5; --dim:#8ea0b5; --accent:#31e0a5; --accent2:#4aa8ff;\n    --warn:#ffb454; --bad:#ff5d6c; --good:#31e0a5;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%}\n  body{\n    background:radial-gradient(1200px 700px at 70% -10%,#16202e 0%,var(--bg) 60%);\n    color:var(--txt); font-family:\"Segoe UI\",system-ui,-apple-system,\"Hiragino Kaku Gothic ProN\",\"Noto Sans JP\",sans-serif;\n    display:flex; flex-direction:column; min-height:100%;\n  }\n  header{\n    padding:14px 22px; border-bottom:1px solid var(--line);\n    display:flex; align-items:center; gap:14px; flex-wrap:wrap;\n    background:linear-gradient(180deg,rgba(20,28,40,.9),rgba(10,14,20,.4));\n    position:sticky; top:0; z-index:20; backdrop-filter:blur(6px);\n  }\n  .logo{display:flex;align-items:center;gap:10px}\n  .logo .mark{width:34px;height:34px;border-radius:9px;\n    background:conic-gradient(from 210deg,var(--accent),var(--accent2),var(--accent));\n    display:grid;place-items:center;font-size:19px;box-shadow:0 0 22px rgba(49,224,165,.35)}\n  h1{font-size:17px;margin:0;letter-spacing:.3px}\n  h1 small{display:block;font-size:11px;color:var(--dim);font-weight:400;letter-spacing:.5px}\n  .spacer{flex:1}\n  .badge{font-size:11px;color:var(--dim);border:1px solid var(--line);padding:5px 10px;border-radius:20px}\n  .badge b{color:var(--accent)}\n\n  main{flex:1;display:grid;grid-template-columns:1.55fr .95fr;gap:16px;padding:16px 22px 30px;align-items:start}\n  @media(max-width:1050px){main{grid-template-columns:1fr}}\n  .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden}\n  .card h2{font-size:13px;margin:0;padding:12px 16px;border-bottom:1px solid var(--line);\n    color:var(--dim);letter-spacing:.8px;text-transform:uppercase;display:flex;align-items:center;gap:8px}\n  .card h2 .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}\n  .pad{padding:16px}\n\n  /* Upload / stage */\n  #stage{position:relative;background:#05080c;min-height:340px;display:grid;place-items:center}\n  #dropzone{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;\n    gap:14px;text-align:center;padding:30px;cursor:pointer;transition:.2s;border:2px dashed transparent}\n  #dropzone.drag{background:rgba(49,224,165,.06);border-color:var(--accent)}\n  #dropzone .big{font-size:52px;filter:drop-shadow(0 6px 18px rgba(49,224,165,.4))}\n  #dropzone p{margin:0;color:var(--dim);max-width:420px;line-height:1.6;font-size:13.5px}\n  .btn{border:none;border-radius:10px;padding:11px 20px;font-size:14px;font-weight:600;cursor:pointer;\n    background:linear-gradient(135deg,var(--accent),#25b88a);color:#04120c;transition:.15s;letter-spacing:.3px}\n  .btn:hover{filter:brightness(1.08);transform:translateY(-1px)}\n  .btn.ghost{background:var(--panel2);color:var(--txt);border:1px solid var(--line)}\n  .btn:disabled{opacity:.4;cursor:not-allowed;transform:none;filter:none}\n  .btn.sm{padding:8px 14px;font-size:12.5px}\n\n  canvas#view{max-width:100%;display:block}\n  video#vid{display:none}\n  #canvasWrap{position:relative;width:100%;display:none;background:#05080c}\n  #canvasWrap.on{display:block}\n\n  /* progress */\n  #progWrap{position:absolute;inset:0;background:rgba(5,8,12,.86);display:none;flex-direction:column;\n    align-items:center;justify-content:center;gap:16px;z-index:5}\n  #progWrap.on{display:flex}\n  .ring{width:74px;height:74px;border-radius:50%;border:5px solid #1e2a38;border-top-color:var(--accent);\n    animation:spin 1s linear infinite}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  #progTxt{color:var(--dim);font-size:13px}\n  .bar{width:min(70%,360px);height:8px;background:#182230;border-radius:6px;overflow:hidden}\n  .bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .1s}\n\n  /* controls */\n  #transport{display:none;padding:12px 16px;border-top:1px solid var(--line);gap:12px;align-items:center;flex-wrap:wrap}\n  #transport.on{display:flex}\n  #scrub{flex:1;min-width:180px;accent-color:var(--accent)}\n  .tbtn{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--panel2);\n    color:var(--txt);font-size:16px;cursor:pointer;display:grid;place-items:center}\n  .tbtn:hover{border-color:var(--accent)}\n  .phasechip{font-size:12px;padding:5px 11px;border-radius:20px;font-weight:600;letter-spacing:.4px}\n\n  /* sliders panel */\n  .ctl{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}\n  .ctl label{font-size:12px;color:var(--dim);display:flex;justify-content:space-between}\n  .ctl label b{color:var(--txt)}\n  input[type=range]{accent-color:var(--accent2);width:100%}\n  .toggle-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}\n  .chip{font-size:12px;padding:7px 12px;border-radius:20px;border:1px solid var(--line);background:var(--panel2);\n    color:var(--dim);cursor:pointer;user-select:none}\n  .chip.on{background:rgba(74,168,255,.16);border-color:var(--accent2);color:#cfe6ff}\n\n  /* metrics */\n  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n  .metric{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px}\n  .metric .k{font-size:11px;color:var(--dim);letter-spacing:.5px}\n  .metric .v{font-size:23px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums}\n  .metric .v small{font-size:12px;color:var(--dim);font-weight:500;margin-left:3px}\n\n  /* 3d */\n  #three{width:100%;height:260px;background:#05080c;border-radius:12px;display:block;cursor:grab}\n  #three:active{cursor:grabbing}\n\n  /* feedback */\n  .fb{display:flex;gap:11px;padding:11px 12px;border-radius:11px;background:var(--panel2);\n    border:1px solid var(--line);margin-bottom:9px;align-items:flex-start}\n  .fb .ic{font-size:18px;line-height:1.2}\n  .fb .t{font-size:13px;line-height:1.55}\n  .fb .t b{color:var(--txt)}\n  .fb.good{border-left:3px solid var(--good)}\n  .fb.warn{border-left:3px solid var(--warn)}\n  .fb.bad{border-left:3px solid var(--bad)}\n  .muted{color:var(--dim);font-size:12.5px;line-height:1.6}\n\n  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--dim);padding:10px 16px;border-top:1px solid var(--line)}\n  .legend span{display:flex;align-items:center;gap:6px}\n  .sw{width:22px;height:8px;border-radius:4px;display:inline-block}\n  footer{padding:14px 22px;color:var(--dim);font-size:11.5px;border-top:1px solid var(--line);line-height:1.6}\n  a{color:var(--accent2)}\n  .hidden{display:none!important}\n</style>\n</head>\n<body>\n<header>\n  <div class=\"logo\">\n    <div class=\"mark\">⛳</div>\n    <h1>Golf 3D Swing Force Analyzer<small>グリップにかかる三次元の力を可視化して自習する</small></h1>\n  </div>\n  <div class=\"spacer\"></div>\n  <div class=\"badge\">解析エンジン: <b>MediaPipe Pose (3D)</b></div>\n  <div class=\"badge\">処理: <b>ブラウザ内 · 動画は外部送信なし</b></div>\n</header>\n\n<main>\n  <!-- LEFT: video + overlay -->\n  <section class=\"card\" style=\"grid-column:1/2\">\n    <h2><span class=\"dot\"></span> スイング動画 &amp; 3D力ベクトル</h2>\n    <div id=\"stage\">\n      <div id=\"dropzone\">\n        <div class=\"big\">🎥</div>\n        <p><b style=\"color:var(--txt)\">スイング動画をアップロード</b><br>\n        ここにドラッグ＆ドロップ、またはクリックして選択。<br>\n        <b style=\"color:var(--txt)\">正面（Face-on）</b> か <b style=\"color:var(--txt)\">飛球線後方（Down-the-line）</b> から撮影した、全身が映る動画がおすすめです。</p>\n        <button class=\"btn\" id=\"pickBtn\">動画を選ぶ</button>\n        <input type=\"file\" id=\"file\" accept=\"video/*\" class=\"hidden\" />\n      </div>\n\n      <div id=\"canvasWrap\">\n        <canvas id=\"view\"></canvas>\n        <div id=\"progWrap\">\n          <div class=\"ring\"></div>\n          <div id=\"progTxt\">姿勢推定モデルを準備中…</div>\n          <div class=\"bar\"><i id=\"progBar\"></i></div>\n        </div>\n      </div>\n      <video id=\"vid\" playsinline muted></video>\n    </div>\n\n    <div id=\"transport\">\n      <button class=\"tbtn\" id=\"playBtn\" title=\"再生/停止\">▶</button>\n      <input type=\"range\" id=\"scrub\" min=\"0\" max=\"0\" value=\"0\" step=\"1\" />\n      <span id=\"timeTxt\" class=\"muted\" style=\"min-width:74px;text-align:right\">0.00s</span>\n      <span class=\"phasechip\" id=\"phaseChip\" style=\"background:#22303f;color:var(--dim)\">—</span>\n      <button class=\"btn ghost sm\" id=\"newBtn\">別の動画</button>\n    </div>\n\n    <div class=\"legend\">\n      <span><i class=\"sw\" style=\"background:linear-gradient(90deg,#ff5d6c,#ffb454)\"></i> 力ベクトル（手→クラブ）</span>\n      <span><i class=\"sw\" style=\"background:#4aa8ff\"></i> スケルトン</span>\n      <span><i class=\"sw\" style=\"background:#31e0a5\"></i> 推定シャフト</span>\n      <span>🔴 手前向き / 🔵 奥向き（Z方向の奥行き）</span>\n    </div>\n  </section>\n\n  <!-- RIGHT: metrics, 3d, feedback, controls -->\n  <div style=\"display:flex;flex-direction:column;gap:16px;grid-column:2/3\">\n    <section class=\"card\">\n      <h2><span class=\"dot\"></span> このフレームの力</h2>\n      <div class=\"pad\">\n        <div class=\"grid2\">\n          <div class=\"metric\"><div class=\"k\">グリップ速度</div><div class=\"v\" id=\"mSpeed\">–<small>km/h</small></div></div>\n          <div class=\"metric\"><div class=\"k\">グリップ力</div><div class=\"v\" id=\"mForce\">–<small>N</small></div></div>\n          <div class=\"metric\"><div class=\"k\">力の向き</div><div class=\"v\" id=\"mDir\" style=\"font-size:16px\">–</div></div>\n          <div class=\"metric\"><div class=\"k\">奥行き Z</div><div class=\"v\" id=\"mZ\" style=\"font-size:16px\">–</div></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card\">\n      <h2><span class=\"dot\"></span> 3D 力ベクトルビュー <span class=\"muted\" style=\"text-transform:none;letter-spacing:0;margin-left:auto;font-size:11px\">ドラッグで回転</span></h2>\n      <div class=\"pad\"><canvas id=\"three\"></canvas></div>\n    </section>\n\n    <section class=\"card\">\n      <h2><span class=\"dot\"></span> スイング診断</h2>\n      <div class=\"pad\">\n        <div class=\"grid2\" style=\"margin-bottom:14px\">\n          <div class=\"metric\"><div class=\"k\">テンポ比 (上げ:下ろし)</div><div class=\"v\" id=\"mTempo\" style=\"font-size:19px\">–</div></div>\n          <div class=\"metric\"><div class=\"k\">最高ヘッド速度換算</div><div class=\"v\" id=\"mPeak\">–<small>km/h</small></div></div>\n        </div>\n        <div id=\"feedback\">\n          <div class=\"muted\">動画を解析すると、テンポ・切り返し・キャスティング（早期リリース）などの自動診断とアドバイスがここに表示されます。</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card\">\n      <h2><span class=\"dot\"></span> 表示設定</h2>\n      <div class=\"pad\">\n        <div class=\"toggle-row\">\n          <div class=\"chip on\" data-t=\"skeleton\">スケルトン</div>\n          <div class=\"chip on\" data-t=\"shaft\">推定シャフト</div>\n          <div class=\"chip on\" data-t=\"gravity\">重力補償</div>\n          <div class=\"chip\" data-t=\"trail\">グリップ軌道</div>\n        </div>\n        <div class=\"ctl\"><label>矢印スケール <b id=\"lArrow\">1.0×</b></label><input type=\"range\" id=\"sArrow\" min=\"0.3\" max=\"2.5\" step=\"0.1\" value=\"1\"></div>\n        <div class=\"ctl\"><label>推定クラブ+手 実効質量 <b id=\"lMass\">0.6 kg</b></label><input type=\"range\" id=\"sMass\" min=\"0.2\" max=\"1.5\" step=\"0.05\" value=\"0.6\"></div>\n        <div class=\"ctl\"><label>スムージング <b id=\"lSmooth\">中</b></label><input type=\"range\" id=\"sSmooth\" min=\"0\" max=\"6\" step=\"1\" value=\"3\"></div>\n      </div>\n    </section>\n  </div>\n</main>\n\n<footer>\n  <b>仕組み：</b> ブラウザ内で MediaPipe Pose の3D姿勢推定を動画に適用し、両手首の中点＝<b>グリップ</b>の3D位置を毎フレーム追跡します。\n  その3D加速度から <b>F = m·a（＋重力補償）</b> を計算し、手がクラブに与えている力の方向を三次元の矢印として重ねます。\n  単眼動画のため奥行き(Z)と絶対値は推定であり、フォームの傾向を掴む学習用ツールとしてご利用ください。\n</footer>\n\n<script type=\"module\">\nimport { PoseLandmarker, FilesetResolver } from \"https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14\";\nimport * as THREE from \"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\";\nimport { OrbitControls } from \"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js\";\n\n/* ---------- DOM ---------- */\nconst $ = s => document.querySelector(s);\nconst dropzone=$(\"#dropzone\"), pickBtn=$(\"#pickBtn\"), fileInput=$(\"#file\");\nconst stage=$(\"#stage\"), wrap=$(\"#canvasWrap\"), view=$(\"#view\"), vid=$(\"#vid\");\nconst progWrap=$(\"#progWrap\"), progTxt=$(\"#progTxt\"), progBar=$(\"#progBar\");\nconst transport=$(\"#transport\"), playBtn=$(\"#playBtn\"), scrub=$(\"#scrub\"), timeTxt=$(\"#timeTxt\");\nconst phaseChip=$(\"#phaseChip\"), newBtn=$(\"#newBtn\");\nconst ctx=view.getContext(\"2d\");\n\nconst opts={ skeleton:true, shaft:true, gravity:true, trail:false,\n  arrow:1, mass:0.6, smooth:3 };\n\n/* ---------- state ---------- */\nlet landmarker=null, frames=[], analysis=null, curIdx=0, playing=false, rvfcId=0;\n\n/* ================= Pose model ================= */\nasync function ensureModel(){\n  if(landmarker) return landmarker;\n  progTxt.textContent=\"姿勢推定モデルを準備中…\";\n  const fileset=await FilesetResolver.forVisionTasks(\n    \"https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm\");\n  landmarker=await PoseLandmarker.createFromOptions(fileset,{\n    baseOptions:{ modelAssetPath:\n      \"https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task\",\n      delegate:\"GPU\" },\n    runningMode:\"VIDEO\", numPoses:1 });\n  return landmarker;\n}\n\n/* ================= File handling ================= */\npickBtn.addEventListener(\"click\",()=>fileInput.click());\ndropzone.addEventListener(\"click\",e=>{ if(e.target===pickBtn) return; fileInput.click(); });\nfileInput.addEventListener(\"change\",e=>{ if(e.target.files[0]) loadVideo(e.target.files[0]); });\n[\"dragenter\",\"dragover\"].forEach(ev=>dropzone.addEventListener(ev,e=>{e.preventDefault();dropzone.classList.add(\"drag\");}));\n[\"dragleave\",\"drop\"].forEach(ev=>dropzone.addEventListener(ev,e=>{e.preventDefault();dropzone.classList.remove(\"drag\");}));\ndropzone.addEventListener(\"drop\",e=>{ const f=e.dataTransfer.files[0]; if(f&&f.type.startsWith(\"video\")) loadVideo(f); });\nnewBtn.addEventListener(\"click\",resetAll);\n\nfunction resetAll(){\n  playing=false; cancelRVFC(); frames=[]; analysis=null;\n  vid.pause(); if(vid.src) URL.revokeObjectURL(vid.src); vid.removeAttribute(\"src\");\n  dropzone.classList.remove(\"hidden\"); wrap.classList.remove(\"on\");\n  transport.classList.remove(\"on\"); progWrap.classList.remove(\"on\");\n  $(\"#feedback\").innerHTML='<div class=\"muted\">動画を解析すると診断がここに表示されます。</div>';\n  [\"#mSpeed\",\"#mForce\",\"#mTempo\",\"#mPeak\"].forEach(s=>$(s).innerHTML=\"–\");\n  $(\"#mDir\").textContent=\"–\"; $(\"#mZ\").textContent=\"–\";\n}\n\nasync function loadVideo(file){\n  resetAll();\n  dropzone.classList.add(\"hidden\"); wrap.classList.add(\"on\"); progWrap.classList.add(\"on\");\n  progBar.style.width=\"0%\";\n  vid.src=URL.createObjectURL(file);\n  await new Promise((res,rej)=>{ vid.onloadedmetadata=res; vid.onerror=()=>rej(new Error(\"動画を読み込めません\")); });\n  // size canvas (cap width for perf)\n  const maxW=960, scale=Math.min(1,maxW/vid.videoWidth);\n  view.width=Math.round(vid.videoWidth*scale);\n  view.height=Math.round(vid.videoHeight*scale);\n  try{ await ensureModel(); }\n  catch(err){ progTxt.textContent=\"モデル読込に失敗: \"+err.message; return; }\n  await analyze();\n}\n\n/* ================= Analysis pass ================= */\nfunction cancelRVFC(){ if(rvfcId && vid.cancelVideoFrameCallback){ try{vid.cancelVideoFrameCallback(rvfcId);}catch(e){} } rvfcId=0; }\n\nasync function analyze(){\n  frames=[]; progTxt.textContent=\"スイングを解析中…\"; progBar.style.width=\"0%\";\n  let lastTs=-1;\n  vid.currentTime=0; vid.playbackRate=1;\n  const supportsRVFC = 'requestVideoFrameCallback' in HTMLVideoElement.prototype;\n\n  await new Promise(resolve=>{\n    const onFrame=(now,meta)=>{\n      const t = meta ? meta.mediaTime : vid.currentTime;\n      let ts=Math.round(t*1000); if(ts<=lastTs) ts=lastTs+1; lastTs=ts;\n      try{\n        const r=landmarker.detectForVideo(vid,ts);\n        pushFrame(t,r);\n      }catch(e){/* skip frame */}\n      progBar.style.width=Math.min(100,(vid.currentTime/vid.duration)*100).toFixed(0)+\"%\";\n      // live preview during analysis\n      if(frames.length) drawFrame(frames.length-1,true);\n      if(!vid.ended && !vid.paused){ if(supportsRVFC) rvfcId=vid.requestVideoFrameCallback(onFrame); }\n    };\n    vid.onended=()=>{ resolve(); };\n    vid.play().then(()=>{\n      if(supportsRVFC) rvfcId=vid.requestVideoFrameCallback(onFrame);\n      else { // fallback: timer sampling\n        const iv=setInterval(()=>{ if(vid.ended){clearInterval(iv);resolve();return;} onFrame(0,null); },1000/30);\n      }\n    });\n  });\n\n  vid.pause();\n  if(frames.length<8){ progTxt.textContent=\"姿勢を十分に検出できませんでした。全身が映る明るい動画でお試しください。\"; return; }\n  computeAnalysis();\n  progWrap.classList.remove(\"on\");\n  buildTransport();\n  gotoIdx(analysis.impactIdx>0?analysis.impactIdx:0);\n}\n\nfunction pushFrame(t,r){\n  if(!r || !r.landmarks || !r.landmarks[0]) { return; }\n  const lm=r.landmarks[0];               // normalized image coords (0-1), y down\n  const wl=r.worldLandmarks && r.worldLandmarks[0]; // meters\n  const lw=lm[15], rw=lm[16];            // wrists (image)\n  if(!lw||!rw) return;\n  const gripPx={ x:(lw.x+rw.x)/2, y:(lw.y+rw.y)/2 };\n  // 3D grip (meters). MediaPipe world: y down, z toward-camera negative. Flip to y-up, z-out.\n  let grip3D;\n  if(wl && wl[15] && wl[16]){\n    grip3D={ x:(wl[15].x+wl[16].x)/2, y:-(wl[15].y+wl[16].y)/2, z:-(wl[15].z+wl[16].z)/2 };\n  }else{\n    grip3D={ x:gripPx.x-0.5, y:-(gripPx.y-0.5), z:0 };\n  }\n  // shaft direction estimate from forearm (elbow->wrist), avg both arms, in image space\n  const le=lm[13], re=lm[14];\n  let shaft=null;\n  if(le&&re){\n    const dx=((lw.x-le.x)+(rw.x-re.x))/2, dy=((lw.y-le.y)+(rw.y-re.y))/2;\n    const n=Math.hypot(dx,dy)||1; shaft={x:dx/n,y:dy/n};\n  }\n  frames.push({ t, gripPx, grip3D, shaft, lm });\n}\n\n/* ================= Physics ================= */\nconst G=9.81;\nfunction computeAnalysis(){\n  const n=frames.length;\n  const times=frames.map(f=>f.t);\n  const dt=Math.max(1e-3,(times[n-1]-times[0])/(n-1));\n  // smoothing window\n  const w=opts.smooth;\n  const raw=frames.map(f=>f.grip3D);\n  const pos=smoothVec(raw,w);\n  // velocity & acceleration (central diff)\n  const vel=new Array(n), acc=new Array(n), speed=new Array(n);\n  for(let i=0;i<n;i++){\n    const a=pos[Math.max(0,i-1)], b=pos[Math.min(n-1,i+1)];\n    vel[i]={x:(b.x-a.x)/(2*dt),y:(b.y-a.y)/(2*dt),z:(b.z-a.z)/(2*dt)};\n    speed[i]=Math.hypot(vel[i].x,vel[i].y,vel[i].z);\n  }\n  for(let i=0;i<n;i++){\n    const p0=pos[Math.max(0,i-1)],p1=pos[i],p2=pos[Math.min(n-1,i+1)];\n    acc[i]={x:(p2.x-2*p1.x+p0.x)/(dt*dt),y:(p2.y-2*p1.y+p0.y)/(dt*dt),z:(p2.z-2*p1.z+p0.z)/(dt*dt)};\n  }\n  // Force hands apply to club: F = m*a - m*g  (g = (0,-G,0)) => F = m*a + (0, m*G, 0)\n  const m=opts.mass;\n  const force=acc.map(a=>({ x:m*a.x, y:m*a.y+(opts.gravity?m*G:0), z:m*a.z }));\n  const fmag=force.map(f=>Math.hypot(f.x,f.y,f.z));\n  const peakForce=Math.max(...fmag,1e-3);\n  const peakSpeed=Math.max(...speed);\n  const impactIdx=speed.indexOf(peakSpeed);\n  // top of backswing = min speed before impact (skip first frames)\n  let topIdx=Math.max(2,Math.floor(impactIdx*0.15)), minS=Infinity;\n  for(let i=Math.floor(n*0.05);i<impactIdx;i++){ if(speed[i]<minS){minS=speed[i];topIdx=i;} }\n  const tempo=(times[impactIdx]-times[topIdx])>0 ? (times[topIdx]-times[0])/(times[impactIdx]-times[topIdx]) : 0;\n\n  analysis={ n,times,dt,pos,vel,acc,speed,force,fmag,peakForce,peakSpeed,impactIdx,topIdx,tempo };\n  generateFeedback();\n  // header metrics\n  $(\"#mTempo\").innerHTML = tempo>0 ? tempo.toFixed(1)+' : 1' : '–';\n  // grip peak speed -> rough clubhead speed (~ grip speed * lever factor 2.2)\n  const headKmh=peakSpeed*2.2*3.6;\n  $(\"#mPeak\").innerHTML = headKmh.toFixed(0)+'<small>km/h</small>';\n}\n\nfunction smoothVec(arr,w){\n  if(w<=0) return arr.slice();\n  const n=arr.length,out=new Array(n);\n  for(let i=0;i<n;i++){\n    let sx=0,sy=0,sz=0,c=0;\n    for(let k=-w;k<=w;k++){ const j=i+k; if(j<0||j>=n)continue; sx+=arr[j].x;sy+=arr[j].y;sz+=arr[j].z;c++; }\n    out[i]={x:sx/c,y:sy/c,z:sz/c};\n  }\n  return out;\n}\n\n/* ================= Feedback ================= */\nfunction generateFeedback(){\n  const a=analysis, fb=[];\n  // tempo\n  if(a.tempo>0){\n    if(a.tempo>=2.6&&a.tempo<=3.6) fb.push(['good','⏱️',`<b>テンポ良好 (${a.tempo.toFixed(1)}:1)</b> 理想の3:1に近い、切り返しに余裕のあるリズムです。この間合いを維持しましょう。`]);\n    else if(a.tempo<2.6) fb.push(['warn','⏱️',`<b>テンポが速め (${a.tempo.toFixed(1)}:1)</b> トップからの切り返しが急です。バックスイングをもう少しゆっくり、間を作ると再現性が上がります。`]);\n    else fb.push(['warn','⏱️',`<b>テンポが緩やか (${a.tempo.toFixed(1)}:1)</b> ダウンスイングをもう少し積極的に加速させると力が溜まりやすくなります。`]);\n  }\n  // casting / early release: force direction in early downswing should stay \"into\" the swing (large centripetal, not pointing outward/down too early)\n  const ds0=a.topIdx, ds1=a.impactIdx;\n  if(ds1>ds0+2){\n    const early=Math.floor(ds0+(ds1-ds0)*0.25);\n    // compare force magnitude growth: healthy swing keeps building force to impact\n    const fEarly=a.fmag[early], fImpact=a.fmag[ds1];\n    const buildRatio=fImpact/(fEarly||1e-3);\n    if(buildRatio<1.15) fb.push(['bad','🎯',`<b>早期リリース（キャスティング）の兆候</b> ダウンスイング序盤で力のピークが来て、インパクトに向けて力が増えていません。トップで作った角(タメ)を保ち、体の回転で引き下ろす意識を。`]);\n    else fb.push(['good','🎯',`<b>タメを保てています</b> インパクトに向けてグリップの力が ${buildRatio.toFixed(1)}倍 に増加。パワーを最後まで蓄えられています。`]);\n  }\n  // impact timing\n  const pct=a.impactIdx/(a.n-1);\n  if(pct<0.45) fb.push(['warn','📍',`<b>最高速度が早すぎ</b> インパクト前にスピードのピークが来ています。ボール位置で最速になるよう、リリースのタイミングを少し遅らせましょう。`]);\n  else if(pct>0.8) fb.push(['warn','📍',`<b>加速が遅れ気味</b> フォロー側にピークが寄っています。ダウンスイングでもう一段早く加速を始めると距離が伸びます。`]);\n  else fb.push(['good','📍',`<b>インパクトで最速</b> スピードのピークがボール位置付近。理想的なエネルギーの伝達です。`]);\n  // path smoothness (jerk)\n  let jerk=0; for(let i=1;i<a.n;i++){ jerk+=Math.abs(a.fmag[i]-a.fmag[i-1]); } jerk/=a.n;\n  if(jerk> a.peakForce*0.22) fb.push(['warn','〰️',`<b>力の伝わりに引っかかり</b> 力のカーブがギクシャクしています。手先で操作せず、大きな筋肉（体幹・下半身）で滑らかに振る意識を。`]);\n  else fb.push(['good','〰️',`<b>滑らかな加速</b> 力が途切れなく増えており、効率よくエネルギーを伝えられています。`]);\n  // peak force info\n  fb.push(['good','💪',`<b>推定ピーク力 ${a.peakForce.toFixed(0)} N</b> ・ グリップ最高速 ${(a.peakSpeed*3.6).toFixed(0)} km/h（ヘッド換算 約${(a.peakSpeed*2.2*3.6).toFixed(0)} km/h）。矢印が最も長くなる瞬間がリリースのポイントです。`]);\n\n  $(\"#feedback\").innerHTML=fb.map(([cls,ic,t])=>\n    `<div class=\"fb ${cls}\"><div class=\"ic\">${ic}</div><div class=\"t\">${t}</div></div>`).join(\"\");\n}\n\n/* ================= Phases ================= */\nfunction phaseOf(i){\n  const a=analysis; if(!a) return {name:'—',col:'#8ea0b5'};\n  if(i<=a.topIdx*0.4) return {name:'アドレス/テークバック',col:'#8ea0b5'};\n  if(i<a.topIdx) return {name:'バックスイング',col:'#4aa8ff'};\n  if(i<a.impactIdx) return {name:'ダウンスイング',col:'#ffb454'};\n  if(i<=a.impactIdx+1) return {name:'インパクト',col:'#ff5d6c'};\n  return {name:'フォロースルー',col:'#31e0a5'};\n}\n\n/* ================= Transport ================= */\nfunction buildTransport(){\n  transport.classList.add(\"on\");\n  scrub.max=frames.length-1; scrub.value=0;\n}\nscrub.addEventListener(\"input\",()=>{ playing=false; playBtn.textContent=\"▶\"; gotoIdx(+scrub.value); });\nplayBtn.addEventListener(\"click\",togglePlay);\n\nfunction togglePlay(){\n  if(!analysis) return;\n  playing=!playing; playBtn.textContent=playing?\"⏸\":\"▶\";\n  if(playing){\n    if(curIdx>=frames.length-1) curIdx=0;\n    playFrom(curIdx);\n  }\n}\nfunction playFrom(start){\n  const t0=performance.now(), base=frames[start].t;\n  function step(now){\n    if(!playing) return;\n    const elapsed=(now-t0)/1000;\n    let i=start;\n    while(i<frames.length-1 && frames[i].t-base < elapsed) i++;\n    gotoIdx(i);\n    if(i>=frames.length-1){ playing=false; playBtn.textContent=\"▶\"; return; }\n    requestAnimationFrame(step);\n  }\n  requestAnimationFrame(step);\n}\n\nfunction gotoIdx(i){\n  curIdx=Math.max(0,Math.min(frames.length-1,i));\n  scrub.value=curIdx;\n  // seek video to frame time so overlay matches\n  if(Math.abs(vid.currentTime-frames[curIdx].t)>0.04){\n    vid.currentTime=frames[curIdx].t;\n    vid.onseeked=()=>{ drawFrame(curIdx,false); };\n  }else{\n    drawFrame(curIdx,false);\n  }\n  updateHUD(curIdx);\n}\n\n/* ================= Drawing ================= */\nconst CONN=[[11,12],[11,13],[13,15],[12,14],[14,16],[11,23],[12,24],[23,24],\n  [23,25],[25,27],[24,26],[26,28],[15,17],[16,18],[15,19],[16,20],[27,31],[28,32]];\n\nfunction drawFrame(i,live){\n  const W=view.width,H=view.height;\n  ctx.drawImage(vid,0,0,W,H);\n  ctx.fillStyle=\"rgba(5,8,12,0.15)\"; ctx.fillRect(0,0,W,H);\n  const f=frames[i];\n  if(opts.trail && analysis) drawTrail(i,W,H);\n  if(opts.skeleton) drawSkeleton(f,W,H);\n  if(opts.shaft) drawShaft(f,W,H);\n  if(analysis && !live) drawForce(i,W,H);\n  else if(analysis && live && analysis.force) drawForce(i,W,H);\n}\n\nfunction drawSkeleton(f,W,H){\n  ctx.lineWidth=Math.max(2,W/320); ctx.strokeStyle=\"rgba(74,168,255,.8)\";\n  for(const [a,b] of CONN){\n    const p=f.lm[a],q=f.lm[b]; if(!p||!q) continue;\n    if((p.visibility!=null&&p.visibility<0.3)||(q.visibility!=null&&q.visibility<0.3)) continue;\n    ctx.beginPath(); ctx.moveTo(p.x*W,p.y*H); ctx.lineTo(q.x*W,q.y*H); ctx.stroke();\n  }\n  ctx.fillStyle=\"rgba(74,168,255,.95)\";\n  for(const idx of [11,12,13,14,15,16,23,24,25,26]){\n    const p=f.lm[idx]; if(!p) continue;\n    ctx.beginPath(); ctx.arc(p.x*W,p.y*H,Math.max(2.5,W/260),0,7); ctx.fill();\n  }\n}\nfunction drawShaft(f,W,H){\n  if(!f.shaft) return;\n  const gx=f.gripPx.x*W, gy=f.gripPx.y*H;\n  const len=Math.min(W,H)*0.42;\n  ctx.strokeStyle=\"rgba(49,224,165,.9)\"; ctx.lineWidth=Math.max(3,W/220);\n  ctx.beginPath(); ctx.moveTo(gx,gy); ctx.lineTo(gx+f.shaft.x*len,gy+f.shaft.y*len); ctx.stroke();\n  // clubhead dot\n  ctx.fillStyle=\"#31e0a5\";\n  ctx.beginPath(); ctx.arc(gx+f.shaft.x*len,gy+f.shaft.y*len,Math.max(4,W/150),0,7); ctx.fill();\n}\nfunction drawTrail(i,W,H){\n  ctx.lineWidth=Math.max(2,W/300);\n  for(let k=1;k<=i;k++){\n    const p=frames[k-1].gripPx,q=frames[k].gripPx;\n    const on=k<=i?1:0; ctx.strokeStyle=`rgba(255,180,84,${0.12+0.5*(k/i)})`;\n    ctx.beginPath(); ctx.moveTo(p.x*W,p.y*H); ctx.lineTo(q.x*W,q.y*H); ctx.stroke();\n  }\n}\nfunction drawForce(i,W,H){\n  const F=analysis.force[i]; const mag=analysis.fmag[i];\n  const gx=frames[i].gripPx.x*W, gy=frames[i].gripPx.y*H;\n  const norm=mag/analysis.peakForce;\n  const L=Math.min(W,H)*0.5*norm*opts.arrow;\n  if(L<3) return;\n  // screen dir: x right, y down => screen dy = -Fy (physics y up)\n  const dx=F.x, dy=-F.y; const dn=Math.hypot(dx,dy)||1;\n  const ex=gx+dx/dn*L, ey=gy+dy/dn*L;\n  // depth color: z>0 toward camera => warm(red), z<0 away => cool(blue)\n  const zt=Math.max(-1,Math.min(1,F.z/(mag||1)));\n  const warm=[255,93,108], cool=[74,168,255], mid=[255,180,84];\n  const col = zt>=0 ? lerpC(mid,warm,zt) : lerpC(mid,cool,-zt);\n  const rgb=`rgb(${col[0]|0},${col[1]|0},${col[2]|0})`;\n  // glow\n  ctx.save();\n  ctx.shadowColor=rgb; ctx.shadowBlur=18*norm+6;\n  ctx.strokeStyle=rgb; ctx.lineWidth=Math.max(4,W/150)*(0.6+norm);\n  ctx.lineCap=\"round\";\n  ctx.beginPath(); ctx.moveTo(gx,gy); ctx.lineTo(ex,ey); ctx.stroke();\n  // arrowhead (scaled by depth to fake 3D)\n  const ang=Math.atan2(ey-gy,ex-gx);\n  const head=(14+18*norm)*(1+0.4*zt);\n  ctx.fillStyle=rgb; ctx.beginPath();\n  ctx.moveTo(ex,ey);\n  ctx.lineTo(ex-head*Math.cos(ang-0.4),ey-head*Math.sin(ang-0.4));\n  ctx.lineTo(ex-head*Math.cos(ang+0.4),ey-head*Math.sin(ang+0.4));\n  ctx.closePath(); ctx.fill();\n  ctx.restore();\n  // grip node\n  ctx.fillStyle=\"#fff\"; ctx.beginPath(); ctx.arc(gx,gy,Math.max(4,W/170),0,7); ctx.fill();\n}\nfunction lerpC(a,b,t){return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t];}\n\n/* ================= HUD ================= */\nfunction updateHUD(i){\n  if(!analysis) return;\n  const sp=analysis.speed[i], F=analysis.force[i], mag=analysis.fmag[i];\n  $(\"#mSpeed\").innerHTML=(sp*3.6).toFixed(1)+'<small>km/h</small>';\n  $(\"#mForce\").innerHTML=mag.toFixed(0)+'<small>N</small>';\n  // direction label\n  const up=F.y>0?'上':'下', side=F.x>0?'右':'左';\n  const domXY=Math.abs(F.x)>Math.abs(F.y)?side:up;\n  $(\"#mDir\").textContent=`${domXY}向き · 前後${F.z>0?'手前':'奥'}`;\n  const zt=F.z/(mag||1);\n  $(\"#mZ\").innerHTML=(F.z>=0?'+':'')+F.z.toFixed(0)+'N '+(F.z>0?'(手前)':'(奥)');\n  timeTxt.textContent=frames[i].t.toFixed(2)+'s';\n  const ph=phaseOf(i); phaseChip.textContent=ph.name; phaseChip.style.background=ph.col+'22'; phaseChip.style.color=ph.col;\n  update3D(i);\n}\n\n/* ================= Three.js 3D vector view ================= */\nlet scene,cam,renderer,controls,arrow3d,trail3d;\nfunction initThree(){\n  const c=$(\"#three\"); const w=c.clientWidth||360, h=260;\n  renderer=new THREE.WebGLRenderer({canvas:c,antialias:true,alpha:true});\n  renderer.setPixelRatio(Math.min(2,devicePixelRatio)); renderer.setSize(w,h,false);\n  scene=new THREE.Scene();\n  cam=new THREE.PerspectiveCamera(45,w/h,0.1,100); cam.position.set(2.4,1.6,2.8);\n  controls=new OrbitControls(cam,c); controls.enablePan=false; controls.minDistance=2; controls.maxDistance=8;\n  scene.add(new THREE.AmbientLight(0xffffff,0.7));\n  const d=new THREE.DirectionalLight(0xffffff,0.8); d.position.set(3,5,2); scene.add(d);\n  // ground grid\n  const grid=new THREE.GridHelper(4,8,0x26313f,0x1b2430); grid.position.y=-1; scene.add(grid);\n  // axes\n  scene.add(new THREE.AxesHelper(1.1));\n  // body reference (a simple torso column)\n  const torso=new THREE.Mesh(new THREE.CylinderGeometry(0.12,0.16,1.2,16),\n    new THREE.MeshStandardMaterial({color:0x2a3646,transparent:true,opacity:0.5}));\n  torso.position.y=-0.2; scene.add(torso);\n  // grip sphere\n  const grip=new THREE.Mesh(new THREE.SphereGeometry(0.07,20,20),\n    new THREE.MeshStandardMaterial({color:0xffffff,emissive:0x334455})); scene.add(grip);\n  // force arrow\n  arrow3d=new THREE.ArrowHelper(new THREE.Vector3(1,0,0),new THREE.Vector3(0,0,0),1,0xff5d6c,0.28,0.16);\n  scene.add(arrow3d);\n  animate();\n}\nfunction animate(){ requestAnimationFrame(animate); controls&&controls.update(); renderer&&renderer.render(scene,cam); }\nfunction update3D(i){\n  if(!arrow3d||!analysis) return;\n  const F=analysis.force[i], mag=analysis.fmag[i]||1e-3;\n  const v=new THREE.Vector3(F.x,F.y,F.z);\n  const len=Math.max(0.15,1.7*(mag/analysis.peakForce));\n  v.normalize(); arrow3d.setDirection(v); arrow3d.setLength(len,0.26*len+0.05,0.14*len+0.03);\n  const zt=Math.max(-1,Math.min(1,F.z/mag));\n  const col=zt>=0?lerpC([255,180,84],[255,93,108],zt):lerpC([255,180,84],[74,168,255],-zt);\n  arrow3d.setColor(new THREE.Color(col[0]/255,col[1]/255,col[2]/255));\n}\n\n/* ================= Controls wiring ================= */\ndocument.querySelectorAll(\".chip[data-t]\").forEach(ch=>{\n  ch.addEventListener(\"click\",()=>{ ch.classList.toggle(\"on\"); opts[ch.dataset.t]=ch.classList.contains(\"on\");\n    if(analysis) drawFrame(curIdx,false); });\n});\n$(\"#sArrow\").addEventListener(\"input\",e=>{ opts.arrow=+e.target.value; $(\"#lArrow\").textContent=opts.arrow.toFixed(1)+\"×\"; if(analysis){drawFrame(curIdx,false);update3D(curIdx);} });\n$(\"#sMass\").addEventListener(\"input\",e=>{ opts.mass=+e.target.value; $(\"#lMass\").textContent=opts.mass.toFixed(2)+\" kg\"; recompute(); });\n$(\"#sSmooth\").addEventListener(\"input\",e=>{ opts.smooth=+e.target.value; $(\"#lSmooth\").textContent=[\"なし\",\"弱\",\"弱+\",\"中\",\"中+\",\"強\",\"最大\"][opts.smooth]; recompute(); });\nfunction recompute(){ if(frames.length>=8){ computeAnalysis(); drawFrame(curIdx,false); updateHUD(curIdx);} }\n\n/* init 3d after layout */\nwindow.addEventListener(\"load\",()=>{ try{ initThree(); }catch(e){ console.warn(e);} });\nwindow.addEventListener(\"resize\",()=>{ if(renderer){ const c=$(\"#three\"); renderer.setSize(c.clientWidth,260,false); cam.aspect=c.clientWidth/260; cam.updateProjectionMatrix(); } });\n</script>\n</body>\n</html>"},"ts":"2026-07-19T13:14:26.313Z"}
