        "amount": {
          "type": "money",
          "label": "金額",
          "currency": "JPY"
        },
        "count": {
          "type": "number",
          "label": "件数"
        }
      }
    },
    "note": {
      "type": "text",
      "label": "メモ"
    }
  },
  "displayField": "category",
  "views": [
    {
      "id": "dashboard",
      "label": "内訳ダッシュボード",
      "icon": "insights",
      "file": "views/dashboard.html",
