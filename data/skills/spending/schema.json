      "values": [
        "Suicaチャージ",
        "外食・カフェ",
        "サブスク・デジタル",
        "衣料・雑貨",
        "スーパー",
        "ドラッグストア",
        "Amazon通販",
        "JR東日本(駅ビル物販)",
        "コンビニ",
        "美容",
        "医療",
        "分割払い",
        "chocoZAP"
