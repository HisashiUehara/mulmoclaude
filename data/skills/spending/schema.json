    "amount": {
      "type": "money",
      "label": "金額",
      "required": true,
      "currency": "JPY"
    },
    "count": {
      "type": "number",
      "label": "件数"
    },
    "merchants": {
      "type": "table",
      "label": "店舗別内訳",
